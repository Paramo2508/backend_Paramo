NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL/PostGIS (docker-compose.yml uses the same variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weathermapz
DB_USER=weathermapz
DB_PASSWORD=change_me
DB_TEST_NAME=weathermapz_test
# Optional: overrides the DB_* values above (e.g. managed databases)
DATABASE_URL=
TEST_DATABASE_URL=

OPENROUTESERVICE_GEOCODING_BASE_URL=https://api.heigit.org/pelias/v1
OPENROUTESERVICE_DIRECTIONS_BASE_URL=https://api.openrouteservice.org/v2/directions
ORS_API_KEY=your_openrouteservice_api_key_here

# Optional: association of trees and buildings to street segments (defaults shown, ADR-009)
# ASSOC_MAX_NEAREST_M=150
# ASSOC_KNN_CANDIDATES=10
# ASSOC_TREE_RADIUS_M=25
# ASSOC_BUILDING_MIN_RADIUS_M=30
# ASSOC_BUILDING_HEIGHT_FACTOR=1.5
# ASSOC_MIN_PCT=95
# ASSOC_BATCH_SIZE=20000

# Optional: limits of the shadow calculation (defaults shown, ADR-015)
# SHADOW_MIN_SUN_ELEVATION_DEG=10
# SHADOW_QUERY_TIMEOUT_MS=20000

# Optional: vegetation index of the street segments (defaults shown, ADR-026)
# VEGETATION_TREE_RADIUS_M=8
# VEGETATION_BATCH_SIZE=5000
# VEGETATION_BATCH_TIMEOUT_MS=60000

# Optional: openness of the street segments for the wind (defaults shown, ADR-028)
# OPENNESS_SAMPLE_SPACING_M=20
# OPENNESS_MAX_DISTANCE_M=40
# OPENNESS_BATCH_SIZE=2000
# OPENNESS_BATCH_TIMEOUT_MS=120000

# Autenticación (PBI-4)
# Secreto para firmar los JWT: cadena larga y aleatoria (p. ej. `openssl rand -hex 32`)
JWT_SECRET=change_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# URL del frontend a la que vuelve el login con Google
FRONTEND_URL=http://localhost:5173
# Credenciales OAuth de Google Cloud Console (opcionales: sin ellas solo funciona email/contraseña)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
